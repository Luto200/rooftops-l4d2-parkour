Rooftops & Alleys x Left 4 Dead 2 Parkour Mashup — GitHub Repository Bundle

Follow these steps to publish your repository to GitHub and link it directly to Melty:

Create your public repository here: github.com/new?name=rooftops-l4d2-parkour

Create the folder structure and paste the following files into your repository root.

File 1: melty.json (Repository Root)

Save this file as melty.json at the root of your repository:

{
  "schemaVersion": 1,
  "games": [
    {
      "slug": "left-4-dead-2",
      "role": "primary",
      "loaders": ["sourcemod", "metamod-source"]
    },
    {
      "slug": "custom-rooftops-and-alleys-the-parkour-game",
      "role": "companion"
    }
  ],
  "components": [
    {
      "id": "rooftops-l4d2-parkour",
      "fileName": "rooftops-l4d2-parkour-1.0.0.zip",
      "files": [
        {
          "source": "addons/sourcemod/plugins/rooftops_l4d2_parkour.smx",
          "destination": "{game}/left4dead2/addons/sourcemod/plugins/rooftops_l4d2_parkour.smx"
        },
        {
          "source": "addons/sourcemod/scripting/rooftops_l4d2_parkour.sp",
          "destination": "{game}/left4dead2/addons/sourcemod/scripting/rooftops_l4d2_parkour.sp"
        },
        {
          "source": "sheets/tricks.json",
          "destination": "{game}/left4dead2/addons/sourcemod/configs/rooftops_sheets/tricks.json"
        },
        {
          "source": "sheets/systems.json",
          "destination": "{game}/left4dead2/addons/sourcemod/configs/rooftops_sheets/systems.json"
        },
        {
          "source": "sheets/hooks.json",
          "destination": "{game}/left4dead2/addons/sourcemod/configs/rooftops_sheets/hooks.json"
        },
        {
          "source": "cfg/melty_rooftops.cfg",
          "destination": "{game}/left4dead2/cfg/melty_rooftops.cfg"
        }
      ]
    }
  ],
  "launch": {
    "kind": "game",
    "args": [
      "-insecure",
      "-console",
      "+sv_lan 0",
      "+rooftops_companion_dir \"{game:custom-rooftops-and-alleys-the-parkour-game}\"",
      "+map c8m5_rooftop"
    ]
  },
  "multiplayer": {
    "mode": "coop",
    "maxPlayers": 4,
    "connect": {
      "address": {
        "log": "{game}/left4dead2/melty.log",
        "after": "Melty join address: "
      },
      "hostArgs": [
        "-insecure",
        "+hostport {port}",
        "+map c8m5_rooftop"
      ],
      "joinArgs": [
        "-insecure",
        "+connect {address}"
      ],
      "joinFile": {
        "path": "{game}/left4dead2/melty.properties",
        "key": "join"
      }
    }
  },
  "test": {
    "checks": [
      {
        "log": "{game}/left4dead2/melty.log",
        "contains": "[MELTY_TEST] Parkour systems initialized"
      },
      {
        "log": "{game}/left4dead2/melty.log",
        "contains": "[MELTY_TEST] Companion game verified"
      },
      {
        "log": "{game}/left4dead2/melty.log",
        "contains": "[MELTY_TEST] Zombie director disabled"
      },
      {
        "log": "{game}/left4dead2/melty.log",
        "contains": "[MELTY_TEST] Trick & Session Marker self-test passed"
      }
    ]
  }
}


File 2: cfg/melty_rooftops.cfg

Save this file as cfg/melty_rooftops.cfg:

// Melty Rooftops & Alleys x Left 4 Dead 2 Configuration
director_no_mobs 1
director_no_specials 1
director_no_bosses 1
z_common_limit 0
sv_gravity 650


